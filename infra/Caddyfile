	reverse_proxy n8n:5678
}

{$WEB_HOST} {
	handle /login {
		reverse_proxy frontend:3000
	}

	handle /library {
		reverse_proxy frontend:3000
	}

	handle /library/* {
		reverse_proxy frontend:3000
	}

	handle /_next/* {
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy web:8000
	}
}
