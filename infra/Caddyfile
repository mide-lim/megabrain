	}

	handle /login {
		reverse_proxy frontend:3000
	}

	handle /inbox {
		reverse_proxy frontend:3000
	}

	handle /inbox/* {
		reverse_proxy frontend:3000
	}

	handle /library {
		reverse_proxy frontend:3000
	}

	handle /library/* {
		reverse_proxy frontend:3000
	}

	handle /categories {
		reverse_proxy frontend:3000
	}

	handle /categories/* {
		reverse_proxy frontend:3000
	}

	handle /settings {
		reverse_proxy frontend:3000
	}

	handle /settings/* {
		reverse_proxy frontend:3000
	}

	handle /_next/* {
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy web:8000
	}
}
