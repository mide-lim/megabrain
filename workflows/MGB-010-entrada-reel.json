{
  "name": "MGB-010 — Entrada de Reel",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "id": "__NODE_ID_MGB_010_01__",
      "name": "SUB — Receber Reels"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const message = $json.message ?? {};\nconst text = typeof message.text === 'string' ? message.text : '';\nconst match = text.match(/https?:\\/\\/(?:www\\.)?instagram\\.com\\/(?:reel|reels)\\/[^\\s<>\"']+/i);\nconst chatId = message.chat?.id;\nconst userId = message.from?.id;\nconst messageId = message.message_id;\n\nif (!match || !Number.isSafeInteger(chatId) || chatId === 0 || !Number.isSafeInteger(userId) || userId <= 0 || !Number.isSafeInteger(messageId) || messageId <= 0) {\n  throw new Error('Não foi encontrado um request Telegram válido para Reel.');\n}\n\nreturn {\n  url: match[0],\n  telegram: {\n    chat_id: chatId,\n    user_id: userId,\n    message_id: messageId,\n    raw_message: text,\n  },\n  notification_chat_id: chatId,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0],
      "id": "__NODE_ID_MGB_010_02__",
      "name": "DATA — Extrair request Telegram"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://web:8000/internal/reels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { url: $json.url, telegram: $json.telegram } }}",
        "options": {
          "timeout": 5000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [448, 0],
      "id": "__NODE_ID_MGB_010_03__",
      "name": "HTTP — Registrar Reel no FastAPI",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CREDENTIAL_ID_N8N_TO_WEB_INGESTION__",
          "name": "__CREDENTIAL_NAME_N8N_TO_WEB_INGESTION__"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "__CONDITION_ID_MGB_010_01__",
              "leftValue": "={{ $json.dispatch?.state }}",
              "rightValue": "accepted",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [672, 0],
      "id": "__NODE_ID_MGB_010_04__",
      "name": "IF — Dispatch aceito?"
    },
    {
      "parameters": {
