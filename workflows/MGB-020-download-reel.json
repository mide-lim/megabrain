    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE app.reels\nSET\n    status = 'downloading',\n    download_started_at = NOW(),\n    error_message = NULL,\n    updated_at = NOW()\nWHERE id = $1::BIGINT\nRETURNING\n    id,\n    shortcode,\n    original_url,\n    status,\n    telegram_chat_id;",
        "options": {
          "queryReplacement": "={{ [$json.id] }}"
        }
      },
