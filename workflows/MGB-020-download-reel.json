    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE app.reels\nSET\n    status = 'downloaded',\n\n    title = $2,\n    creator = $3,\n    caption = $4,\n    duration_seconds = $5::NUMERIC,\n\n    filename = $6,\n    mime_type = $7,\n    file_size_bytes = $8::BIGINT,\n    sha256 = $9,\n\n    storage_provider = $10,\n    storage_bucket = $11,\n    object_key = $12,\n\n    downloaded_at = $13::TIMESTAMPTZ,\n\n    error_message = NULL,\n    updated_at = NOW()\nWHERE id = $1::BIGINT\nRETURNING\n    id,\n    id AS reel_id,\n    shortcode,\n    original_url,\n    status,\n    telegram_chat_id,\n    filename,\n    file_size_bytes,\n    storage_bucket,\n    object_key,\n    downloaded_at;",
        "options": {
          "queryReplacement": "={{ [   $json.item_id,   $json.title ?? null,   $json.creator ?? null,   $json.caption ?? null,   $json.duration_seconds ?? null,   $json.filename,   $json.mime_type,   $json.file_size_bytes,   $json.sha256,   $json.storage_provider,   $json.storage_bucket,   $json.object_key,   $json.downloaded_at ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        832,
