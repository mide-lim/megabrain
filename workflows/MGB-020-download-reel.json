        "jsonBody": "={{ {\n  item_id: Number(\n    $('DB — Marcar downloading').item.json.id\n  ),\n  shortcode:\n    $('DB — Marcar downloading').item.json.shortcode,\n  url:\n    $('DB — Marcar downloading').item.json.original_url,\n  telegram_chat_id: Number(\n    $('DB — Marcar downloading').item.json.telegram_chat_id\n  )\n} }}",
