    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE app.reels\nSET\n    status = 'download_failed',\n    error_message = $2,\n    retry_count = retry_count + 1,\n    last_error_at = NOW(),\n    updated_at = NOW()\nWHERE id = $1::BIGINT\nRETURNING\n    id,\n    shortcode,\n    original_url,\n    status,\n    telegram_chat_id,\n    error_message,\n    retry_count;",
        "options": {
